# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
env/
.env

# ── Database ──────────────────────────────────────────────────────────────────
healthcare.duckdb
healthcare.duckdb.wal

# ── Data (generated files, not source) ───────────────────────────────────────
data/raw/*.csv
data/rejected/*.csv
data/logs/*.log

# ── Vector DB (regenerated on first run) ─────────────────────────────────────
rag/chroma_db/

# ── ML Models (regenerated by train step) ────────────────────────────────────
*.joblib
models/*.joblib

# ── Generated PDFs (large binaries — not needed in source repo) ──────────────
*.pdf

# ── Temp report-part markdown files ──────────────────────────────────────────
report_part*.md
paper_part*.md
*_Rendered.md
*_diagram_*.mmd
*_diagram_*.png

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Playwright browser cache ──────────────────────────────────────────────────
ms-playwright/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
