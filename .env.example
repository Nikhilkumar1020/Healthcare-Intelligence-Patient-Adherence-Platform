# ============================================================
# Healthcare Intelligence Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_platform
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/healthcare_platform

# --- AI Provider (Groq) ---
GROQ_API_KEY=your_groq_api_key_here-...

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# --- ML ---
MODEL_VERSION=v1.0
MODEL_PATH=models/

# --- RAG ---
CHROMA_PERSIST_DIR=rag/chroma_db
RAG_DOCUMENTS_DIR=rag/documents
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ---
DASHBOARD_PORT=8501
